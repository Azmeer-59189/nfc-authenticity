# PostgreSQL connection string
# Example (local): postgresql://postgres:postgres@localhost:5432/nfc_authenticity
# Example (hosted, e.g. Neon/Supabase/RDS): postgresql://user:pass@host:5432/dbname?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nfc_authenticity"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/nfc_authenticity"

# Long random string used to sign admin session JWTs. Generate with:
# openssl rand -base64 48
JWT_SECRET="replace-this-with-a-long-random-string"

# The public base URL of your deployed app. This is what gets encoded into
# every NFC tag, e.g. https://yourapp.com/verify/<nfcId>
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
